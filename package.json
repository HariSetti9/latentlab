{
  "name": "latentlab-dataforge-2026",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "checksums": "node scripts/generate-checksums.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "find:puzzles": "tsx scripts/find-interesting-puzzles.ts",
    "dev": "vite",
    "lint": "eslint .",
    "reproduce": "node scripts/reproduce.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify:presets": "tsx scripts/verify-presets.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
